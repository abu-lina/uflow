# =====================================================
# UAT (User Acceptance Testing) ENVIRONMENT
# =====================================================
# This file is for UAT/testing environment
# Uses: UAT/PROD Supabase Project (same as production)
# 
# To use: Copy this to .env.uat and fill in your UAT/PROD project credentials
# =====================================================

# UAT/PROD Supabase Configuration
# Get these from your UAT/PROD Supabase project:
# 1. Go to Supabase Dashboard → Your UAT/PROD Project
# 2. Settings → API
# 3. Copy Project URL, anon key, and service_role key
# NOTE: This is the SAME project as production, but with different config
#
# Key formats:
#   New (preferred): sb_publishable_... (anon) / sb_secret_... (service role)
#   Legacy (still supported): eyJhbGci... (JWT)
NEXT_PUBLIC_SUPABASE_URL=https://your-uat-prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-uat-prod-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-uat-prod-service-role-key-here

# Unsplash API Key (Plan 119 image enrichment)
# Get this from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Environment
NODE_ENV=development

# Site URL for email links (UAT/testing)
# UAT subdomain: uat.ummahflow.com
NEXT_PUBLIC_SITE_URL=https://uat.ummahflow.com

# Resend API Key for sending emails
# You can use test keys for UAT or same as production
RESEND_API_KEY=re_your_api_key_here

# WhatsApp Contact Number for outreach emails and owner-decision page
# Digits only (e.g., 4915123456789) — used to build wa.me links
# If not set, WhatsApp CTA is hidden from outreach surfaces
WHATSAPP_CONTACT_NUMBER=

# Google Maps API Key (for Quick Create feature)
# Get this from https://console.cloud.google.com/google/maps-apis
# Required APIs: Places API, Geocoding API
# OPTIONAL: Only needed if you want to use Google Places import in Quick Create
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Foursquare Places API Key (for place search enrichment)
# Get this from https://developer.foursquare.com/
# Free tier: 1,000 requests/day
# OPTIONAL: Only needed if you want enhanced place search coverage
NEXT_PUBLIC_FOURSQUARE_API_KEY=your_foursquare_api_key_here

# Mawaqit API Configuration (for prayer times)
# Base URL for Mawaqit API (default: https://api.mawaqit.net)
# Can use public instance or self-hosted
NEXT_PUBLIC_MAWAQIT_API_URL=https://api.mawaqit.net
# Bearer token for Mawaqit API (only if authentication is enabled on your instance)
# OPTIONAL: Only needed if your Mawaqit API instance requires authentication
MAWAQIT_BEARER_TOKEN=your_mawaqit_bearer_token_here

# Push Notifications (VAPID Keys)
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Get these from: https://web-push-codelab.glitch.me/ or run: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# VAPID_PRIVATE_KEY=your_vapid_private_key_here
# VAPID_EMAIL=your-email@example.com

# Notion API Token (for backlog management)
# Get this from https://www.notion.so/my-integrations
# Create an integration and copy the "Internal Integration Token"
# NOTION_API_TOKEN=secret_your_notion_integration_token_here

# Notion Data Source IDs (for API version 2025-09-03)
# These are the data source IDs for your Notion databases
# Get these from your Notion database: "..." menu → "Manage data sources" → "Copy data source ID"
NOTION_EPICS_DATA_SOURCE_ID=2366163f-450b-808a-8b40-000b829c74bd
NOTION_SPRINTS_DATA_SOURCE_ID=2ad6163f-450b-8150-a017-000ba18ab61d
NOTION_ISSUES_DATA_SOURCE_ID=2366163f-450b-809a-ad3c-000b959449b7

# PWA Configuration
# Enable PWA for UAT (service worker enabled for testing)
DISABLE_PWA=false

# Feature Flags - UAT (enable testing features)
NEXT_PUBLIC_FEATURE_SPLASHSCREENDEBUG=true
NEXT_PUBLIC_FEATURE_ENABLEPWAINSTALLPROMPT=false
NEXT_PUBLIC_FEATURE_ENABLEADDRESSVISIBILITYTOGGLE=false
NEXT_PUBLIC_FEATURE_ENABLEQUICKIMPORT=true
NEXT_PUBLIC_FEATURE_ENABLEDEBUGMODE=true

# Admin Debug Key (required for diagnostic endpoints)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_DEBUG_KEY=

# Plausible Analytics (cookie-free, GDPR-compliant)
# Domain registered in your Plausible dashboard
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=uat.ummahflow.com
# Host URL (default: https://plausible.io for managed; set to self-hosted URL if applicable)
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

