{
  "name": "ummah-flow",
  "version": "0.15.21",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:uat": "bash scripts/switch-env.sh uat && npm run dev",
    "dev:prod": "bash scripts/switch-env.sh prod && npm run dev",
    "prebuild": "node scripts/generate-manifest.js",
    "build": "NODE_ENV=production next build --webpack",
    "build:uat": "bash scripts/switch-env.sh uat && npm run build",
    "build:prod": "bash scripts/switch-env.sh prod && npm run build",
    "build:raw": "NODE_ENV=production next build --webpack && node scripts/verify-pwa-output.js",
    "build:standalone": "STANDALONE_BUILD=true NODE_ENV=production next build --webpack && node scripts/verify-pwa-output.js",
    "build:production": "npm ci --include=dev && NODE_ENV=production next build --webpack && rm -rf .next/cache && node scripts/verify-pwa-output.js",
    "start": "NODE_ENV=production next start",
    "start:standalone": "mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cd .next/standalone && NODE_ENV=production node server.js",
    "clean": "rm -rf .next",
    "build:clean": "npm run clean && npm run build",
    "postbuild": "node scripts/verify-pwa-output.js",
    "analyze": "ANALYZE=true next build --webpack && node scripts/verify-pwa-output.js",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:watch": "eslint . --watch",
    "lint:check": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check-all": "npm run type-check && npm run lint:check",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:tailwind": "prettier --plugin-search-dir=. --write 'src/**/*.{js,jsx,ts,tsx,mdx}'",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm run lint && npm run format:check && npm run test",
    "transform-svg": "ts-node scripts/transform-svg.ts",
    "fix:tailwind": "node scripts/fix-tailwind-classes.js",
    "fix:all": "npm run fix:tailwind && npm run format",
    "build:local": "export $(cat .env.local | xargs) && NODE_ENV=production next build --webpack && node scripts/verify-pwa-output.js",
    "refine-tasks-from-top-epic": "npx tsx scripts/refine-top-epic-tasks.ts",
    "remove-watermark": "tsx scripts/remove-lottie-watermark.ts",
    "enrich:images": "npx tsx scripts/enrich-images.ts",
    "perf:test": "bash tests/performance/run-tests.sh",
    "perf:baseline": "bash tests/performance/run-tests.sh baseline",
    "perf:load": "bash tests/performance/run-tests.sh load",
    "perf:stress": "bash tests/performance/run-tests.sh stress",
    "perf:spike": "bash tests/performance/run-tests.sh spike",
    "perf:auth": "bash tests/performance/run-tests.sh auth",
    "perf:browsing": "bash tests/performance/run-tests.sh browsing",
    "perf:admin": "bash tests/performance/run-tests.sh admin",
    "perf:api": "bash tests/performance/run-tests.sh api",
    "perf:uat:baseline": "BASE_URL=https://uat.ummahflow.com ENV=uat bash tests/performance/run-tests.sh baseline",
    "perf:uat:load": "BASE_URL=https://uat.ummahflow.com ENV=uat bash tests/performance/run-tests.sh load",
    "perf:uat:stress": "BASE_URL=https://uat.ummahflow.com ENV=uat bash tests/performance/run-tests.sh stress",
    "perf:uat:spike": "BASE_URL=https://uat.ummahflow.com ENV=uat bash tests/performance/run-tests.sh spike",
    "perf:uat:database": "BASE_URL=https://uat.ummahflow.com ENV=uat bash tests/performance/run-tests.sh database",
    "perf:uat:all": "BASE_URL=https://uat.ummahflow.com ENV=uat bash tests/performance/run-tests.sh all",
    "perf:uat:setup": "node tests/performance/setup-test-data.mjs",
    "perf:uat:cleanup": "node tests/performance/setup-test-data.mjs --cleanup",
    "perf:check-budgets": "node scripts/perf/check-budgets.js",
    "verify:snyk-pr": "bash scripts/verify-snyk-pr.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@iconify/react": "^6.0.0",
    "@supabase/ssr": "^0.12.7",
    "@swc/helpers": "0.5.23",
    "@tanstack/react-query": "^5.104.0",
    "@types/leaflet": "^1.9.22",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastest-levenshtein": "^1.0.16",
    "leaflet": "^1.9.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.23.23",
    "next": "16.3.8",
    "next-intl": "^4.14.7",
    "next-swagger-doc": "^0.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-window": "^1.8.10",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swagger-ui-react": "^5.33.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.25.1",
    "@next/bundle-analyzer": "^16.3.7",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@types/google.maps": "^3.66.4",
    "@types/node": "^22.12.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-window": "^1.8.8",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "^10.6.1",
    "critters": "^0.0.25",
    "dotenv": "^16.4.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "hugeicons-react": "^0.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^15.5.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "5.5.4",
    "vite": "7.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "5.0.2"
  },
  "overrides": {
    "next": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "postcss": "$postcss",
      "sharp": ">=0.35.0"
    },
    "form-data": "4.0.6",
    "vite": "7.3.5",
    "ws@<8": "7.5.11",
    "undici": "7.29.1",
    "dompurify": ">=3.4.12",
    "js-yaml": ">=4.3.0",
    "@babel/core": "7.29.6",
    "esbuild": "0.28.1",
    "minimatch": ">=3.1.5",
    "immutable": ">=5.0.0",
    "serialize-javascript": ">=7.0.5",
    "lodash": ">=4.18.0",
    "picomatch": ">=4.0.4",
    "brace-expansion": ">=5.0.12",
    "fast-uri": ">=3.1.4",
    "yaml": ">=2.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "@types/react": "^18.2.64"
  }
}
