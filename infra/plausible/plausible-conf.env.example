# Example Plausible config — copy to plausible-conf.env and fill in values
# NEVER commit plausible-conf.env to version control

# ── Required ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=CHANGE_ME_64_char_random_string

# Public URL that browsers use to reach Plausible
# Must match the domain in Nginx and in NEXT_PUBLIC_PLAUSIBLE_HOST
BASE_URL=https://analytics.ummahflow.com

# Postgres password (must match POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Optional ────────────────────────────────────────────────────────────────
# Disable registration after first admin account is created
DISABLE_REGISTRATION=true

# SMTP for transactional emails (password resets, weekly digests)
# MAILER_EMAIL=noreply@ummahflow.com
# SMTP_HOST_ADDR=smtp.resend.com
# SMTP_HOST_PORT=465
# SMTP_USER_NAME=resend
# SMTP_USER_PWD=CHANGE_ME_resend_api_key
# SMTP_HOST_SSL_ENABLED=true
