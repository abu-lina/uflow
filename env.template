# Supabase Configuration Template
# Copy this file to .env.local and fill in your actual values

# Get these values from your Supabase project settings:
# 1. Go to your Supabase project dashboard
# 2. Go to Settings > API
# 3. Copy the Project URL and anon public key

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (for API routes)
# Get this from Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: For development
NODE_ENV=development

# Site URL for email links
NEXT_PUBLIC_SITE_URL=https://ummahflow.com

# Resend API Key for sending emails
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Google Maps API Key (for Quick Create feature)
# Get this from https://console.cloud.google.com/google/maps-apis
# Required APIs: Places API, Geocoding API
# OPTIONAL: Only needed if you want to use Google Places import in Quick Create
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Push Notifications (VAPID Keys)
# Generate VAPID keys using: npx web-push generate-vapid-keys
# Get these from: https://web-push-codelab.glitch.me/ or run: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
# VAPID_PRIVATE_KEY=your_vapid_private_key_here
# VAPID_EMAIL=your-email@example.com

# Notion API Token (for backlog management)
# Get this from https://www.notion.so/my-integrations
# Create an integration and copy the "Internal Integration Token"
# NOTION_API_TOKEN=secret_your_notion_integration_token_here

# Notion Data Source IDs (for API version 2025-09-03)
# These are the data source IDs for your Notion databases
# Get these from your Notion database: "..." menu → "Manage data sources" → "Copy data source ID"
NOTION_EPICS_DATA_SOURCE_ID=2366163f-450b-808a-8b40-000b829c74bd
NOTION_SPRINTS_DATA_SOURCE_ID=2ad6163f-450b-8150-a017-000ba18ab61d
NOTION_ISSUES_DATA_SOURCE_ID=2366163f-450b-809a-ad3c-000b959449b7

# Feature Flags
# Set to 'true' to enable features, 'false' to disable
# NEXT_PUBLIC_FEATURE_SPLASHSCREENDEBUG=false
# NEXT_PUBLIC_FEATURE_ENABLEPWAINSTALLPROMPT=false
# NEXT_PUBLIC_FEATURE_ENABLEADDRESSVISIBILITYTOGGLE=false
# NEXT_PUBLIC_FEATURE_ENABLEQUICKIMPORT=false
# NEXT_PUBLIC_FEATURE_ENABLEDEBUGMODE=false

# Plausible Analytics (cookie-free, GDPR-compliant)
# Domain registered in your Plausible dashboard
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ummahflow.com
# Host URL (default: https://plausible.io for managed; set to self-hosted URL if applicable)
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
