# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=Ummah Flow

# Authentication
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_AUTH_LOGOUT_REDIRECT_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_EMAIL_TEMPLATE_ID=your-email-template-id

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_LOGGING=false
NEXT_PUBLIC_ENABLE_MAINTENANCE_MODE=false

# Security
NEXT_PUBLIC_CSP_HEADER=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';
NEXT_PUBLIC_HSTS_HEADER=max-age=63072000; includeSubDomains; preload

# Optional: Third-party Services
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-ga-id
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your-stripe-public-key
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Performance
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_CACHE_CONTROL=max-age=31536000, immutable

# Development
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true
NEXT_PUBLIC_ENABLE_DEBUG_LOGS=false