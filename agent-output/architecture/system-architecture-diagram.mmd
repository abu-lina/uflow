flowchart TB
  %% UFlow System Architecture (focus: Trust & Verification + Performance Caching Layers)

  subgraph Client[Client]
    Browser[Browser]
    PWA[PWA]
    SW[Service Worker (next-pwa)]
  end

  subgraph Edge[Edge + Hosting]
    CF[Cloudflare]
    Nginx[Nginx]
    Docker[Docker]
  end

  subgraph App[Next.js 15 Application]
    UI[UI Pages / Components]
    API[API Routes]
    Services[src/services/*]
  end

  subgraph SB[Supabase]
    Auth[Auth]
    DB[(Postgres + RLS)]
    Storage[Storage]
  end

  subgraph Trust[Trust & Verification Subsystem]
    BadgeTypes[badge_types]
    ProviderBadges[provider_badges]
    Confirmations[badge_confirmations]
    Verifications[badge_verifications]
    Config[badge_system_config]
    TrustSummary[[trust_summary view/materialized view]]
  end

  subgraph External[External Services]
    Resend[Resend]
    Maps[OSM / Nominatim]
  end

  Browser --> SW --> CF --> Nginx --> Docker --> UI
  PWA --> SW
  SW --> CF

  UI --> API
  UI --> Services
  API --> Services

  Services --> Auth
  Services --> DB
  Services --> Storage

  DB --> BadgeTypes
  DB --> ProviderBadges
  DB --> Confirmations
  DB --> Verifications
  DB --> Config
  DB --> TrustSummary

  API --> Resend
  UI --> Maps

  %% Notes
  %% Public UI should read TrustSummary (aggregates), not raw Confirmations.
