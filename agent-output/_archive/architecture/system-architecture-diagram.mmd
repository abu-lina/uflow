  Browser --> SW --> CF --> Nginx --> Docker --> UI
  PWA --> SW
  SW --> CF

  UI --> API
  UI --> Services
  API --> Services
  API --> AdminAPI
  AdminAPI --> EnrichAPI

  Services --> Auth
  Services --> DB
  Services --> Storage

  DB --> BadgeTypes
  DB --> ProviderBadges
  DB --> Confirmations
  DB --> Verifications
  DB --> Config
  DB --> TrustSummary

  %% Enrichment pipeline flow
  CronJob -->|pg_net HTTP POST| EnrichFn
  CronJob --> Vault
  Vault -.->|secrets| CronJob
  EnrichFn -->|fetch source pages| JoinHalal
  EnrichFn -.->|Phase 2 gated| Future
  EnrichFn -->|write candidates| EnrichCandidates
  EnrichFn -->|write run log| EnrichRunLogs
  EnrichFn --> ImportBot

  %% Admin review surface
  EnrichAPI -->|read pending candidates| EnrichCandidates
  EnrichAPI -->|apply approved candidates| Providers
  EnrichAPI -->|mark applied/rejected| EnrichCandidates

  %% CLI enrichment (dry-run / write)
  ImportBot -.->|CLI: enrich-providers.ts| EnrichCandidates

  API --> Resend
  EmailFn --> Resend
  UI --> Maps

  %% Notes
  %% enrichment_candidates is a staging table: pending -> applied/rejected -> archival
  %% cron schedule defined in migration file (ADR-008), NOT dashboard-only
  %% Edge Function can only import ESM-compatible src/lib modules (ADR A-1)
  %% Public UI reads TrustSummary (aggregates), not raw Confirmations (ADR-001)
  %% Legacy in-app admin panel UI removed (Arch 054)
