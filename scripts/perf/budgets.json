{
  "$schema": "./budgets.schema.json",
  "description": "Performance budgets for UFlow critical routes (Plan 033)",
  "thresholds": {
    "firstLoadJS": {
      "providers": {
        "max": 368000,
        "description": "First Load JS for /providers (browse) — measured at 367 kB after chat fallback translations; +1 kB headroom"
      },
      "providersDetail": {
        "max": 286000,
        "description": "First Load JS for /providers/[provider_id] (Plan 210 fallback: measured at 281 kB after map-era shared chunk growth; +5 kB headroom)"
      },
      "shared": {
        "max": 120000,
        "description": "Shared JS (common chunks)"
      }
    },
    "lighthouse": {
      "lcp": {
        "max": 2500,
        "unit": "ms",
        "description": "Largest Contentful Paint (p75 target)"
      },
      "cls": {
        "max": 0.1,
        "description": "Cumulative Layout Shift (p75 target)"
      },
      "inp": {
        "max": 200,
        "unit": "ms",
        "description": "Interaction to Next Paint (p75 target)"
      },
      "performance": {
        "min": 70,
        "description": "Lighthouse performance score (mobile)"
      }
    }
  },
  "routes": {
    "/providers": {
      "budgetKey": "providers",
      "critical": true
    },
    "/providers/[provider_id]": {
      "budgetKey": "providersDetail",
      "critical": true
    }
  }
}
