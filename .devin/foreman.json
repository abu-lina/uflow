{
  "permissions": {
    "allow": [
      "read",
      "grep",
      "glob",
      "Exec(git status)",
      "Exec(git log)",
      "Exec(git diff)",
      "Exec(git show)",
      "Exec(git fetch)",
      "Exec(git rev-list)",
      "Exec(git rev-parse)",
      "Exec(git ls-files)",
      "Exec(git check-ignore)",
      "Exec(git branch --show-current)",
      "Exec(gh issue)",
      "Exec(gh pr view)",
      "Exec(gh pr list)",
      "Exec(gh pr diff)",
      "Exec(gh pr checks)",
      "Exec(gh pr review)",
      "Exec(gh pr update-branch)",
      "Exec(herdr agent list)",
      "Exec(herdr agent get)",
      "Exec(herdr agent read)",
      "Exec(herdr agent wait)",
      "Exec(herdr agent prompt)",
      "Exec(herdr agent send-keys)",
      "Exec(herdr pane read)",
      "Exec(scripts/lane status)"
    ],
    "ask": [
      "Exec(scripts/lane start)",
      "Exec(scripts/lane done)",
      "Exec(gh pr close)",
      "Exec(herdr tab)",
      "Exec(herdr workspace)",
      "Exec(herdr worktree)"
    ],
    "deny": [
      "edit",
      "Write(**)",
      "Exec(git add)",
      "Exec(git commit)",
      "Exec(git push)",
      "Exec(git merge)",
      "Exec(git rebase)",
      "Exec(git reset)",
      "Exec(git checkout)",
      "Exec(git switch)",
      "Exec(git restore)",
      "Exec(git stash)",
      "Exec(git clean)",
      "Exec(git rm)",
      "Exec(npm)",
      "Exec(npx)",
      "Exec(node)",
      "Exec(rm)",
      "Exec(gh pr merge)",
      "Exec(gh repo)",
      "mcp__*"
    ]
  }
}
