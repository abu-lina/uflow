{
  "permissions": {
    "allow": [
      "read",
      "grep",
      "glob",
      "Exec(git status)",
      "Exec(git rev-list)",
      "Exec(git rev-parse)",
      "Exec(git ls-files)",
      "Exec(git check-ignore)",
      "Exec(git branch --show-current)",
      "Exec(gh issue view)",
      "Exec(gh issue list)",
      "Exec(gh issue comment)",
      "Exec(gh issue create)",
      "Exec(gh pr view)",
      "Exec(gh pr list)",
      "Exec(gh pr diff)",
      "Exec(gh pr checks)",
      "Exec(gh pr review)",
      "Exec(gh pr update-branch)",
      "Exec(herdr agent list)",
      "Exec(herdr agent get)",
      "Exec(herdr agent read)",
      "Exec(herdr agent wait)",
      "Exec(herdr agent prompt)",
      "Exec(herdr agent send-keys)",
      "Exec(herdr pane read)",
      "Exec(scripts/lane status)",
      "Exec(scripts/review-bundle)"
    ],
    "ask": [
      "Exec(scripts/lane start)",
      "Exec(scripts/lane done)",
      "Exec(gh pr close)",
      "Exec(herdr tab)",
      "Exec(herdr workspace)",
      "Exec(herdr worktree)"
    ],
    "deny": [
      "edit",
      "Write(**)",
      "Exec(git add)",
      "Exec(git commit)",
      "Exec(git push)",
      "Exec(git merge)",
      "Exec(git rebase)",
      "Exec(git reset)",
      "Exec(git checkout)",
      "Exec(git switch)",
      "Exec(git restore)",
      "Exec(git stash)",
      "Exec(git clean)",
      "Exec(git rm)",
      "Exec(git diff --output)",
      "Exec(git log --output)",
      "Exec(git show --output)",
      "Exec(git diff --output=)",
      "Exec(git log --output=)",
      "Exec(git show --output=)",
      "Exec(git fetch --upload-pack)",
      "Exec(git fetch --upload-pack=)",
      "Exec(git fetch -u)",
      "Exec(git -C)",
      "Exec(git -c)",
      "Exec(env)",
      "Exec(command)",
      "Exec(bash)",
      "Exec(sh)",
      "Exec(zsh)",
      "Exec(eval)",
      "Exec(exec)",
      "Exec(xargs)",
      "Exec(npm)",
      "Exec(npx)",
      "Exec(node)",
      "Exec(rm)",
      "Exec(gh pr merge)",
      "Exec(gh issue delete)",
      "Exec(gh issue transfer)",
      "Exec(gh issue close)",
      "Exec(gh issue pin)",
      "Exec(gh issue lock)",
      "Exec(gh repo)",
      "mcp__*",
      "Read(~/.ssh/**)",
      "Read(~/.config/devin/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.local/share/devin/**)"
    ]
  }
}
